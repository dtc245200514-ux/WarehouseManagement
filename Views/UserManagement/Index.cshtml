@model WarehouseManagement.Models.UserManagement.UserAccountIndexViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="account-management py-3 py-lg-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">Quản trị hệ thống</div>
            <h1 class="h2 mb-1">Quản lý tài khoản</h1>
            <p class="text-secondary mb-0">Tra cứu thông tin, vai trò và trạng thái người dùng trong hệ thống.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="account-summary rounded-3 px-4 py-3 text-center">
                <div class="h3 mb-0">@Model.Users.Count</div>
                <div class="small text-secondary">Kết quả hiển thị</div>
            </div>
            <a asp-action="Create" class="btn btn-primary">Thêm tài khoản</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (TempData["InfoMessage"] is string infoMessage)
    {
        <div class="alert alert-info" role="alert">@infoMessage</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-lg-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <label asp-for="SearchTerm" class="form-label fw-semibold">Tìm kiếm</label>
                    <input asp-for="SearchTerm" class="form-control" maxlength="200"
                           placeholder="Tên đăng nhập, email hoặc họ tên" />
                    <span asp-validation-for="SearchTerm" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label asp-for="Role" class="form-label fw-semibold">Vai trò</label>
                    <select asp-for="Role" class="form-select">
                        <option value="">Tất cả vai trò</option>
                        @foreach (var availableRole in Model.AvailableRoles)
                        {
                            <option value="@availableRole">@availableRole</option>
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="IsActive" class="form-label fw-semibold">Trạng thái</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="true">Hoạt động</option>
                        <option value="false">Không hoạt động</option>
                    </select>
                </div>
                <div class="col-12 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="text-center">STT</th>
                        <th scope="col">Người dùng</th>
                        <th scope="col">Tên đăng nhập</th>
                        <th scope="col">Vai trò</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Ngày tạo</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="h5 mb-2">Không tìm thấy tài khoản</div>
                                <p class="text-secondary mb-0">Hãy thay đổi từ khóa hoặc bộ lọc và thử lại.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        for (var index = 0; index < Model.Users.Count; index++)
                        {
                            var user = Model.Users[index];
                            <tr>
                                <td class="text-center text-secondary">@(index + 1)</td>
                                <td>
                                    <div class="fw-semibold">@user.FullName</div>
                                    <div class="small text-secondary">@user.Email</div>
                                </td>
                                <td><span class="font-monospace">@user.UserName</span></td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (user.Roles.Count == 0)
                                        {
                                            <span class="badge text-bg-secondary">Chưa gán</span>
                                        }
                                        else
                                        {
                                            @foreach (var roleName in user.Roles)
                                            {
                                                var roleBadge = roleName == "ADMIN" ? "text-bg-danger" :
                                                    roleName == "WAREHOUSE_STAFF" ? "text-bg-primary" : "text-bg-info";
                                                <span class="badge @roleBadge">@roleName</span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge rounded-pill text-bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-secondary">Không hoạt động</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="d-flex justify-content-end flex-wrap gap-1">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Chỉnh sửa</a>
                                        @if (user.IsActive)
                                        {
                                            if (user.IsCurrentUser)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" disabled title="Không thể tự khóa tài khoản đang đăng nhập">Khóa</button>
                                            }
                                            else
                                            {
                                                <form asp-action="Lock" asp-route-id="@user.Id" method="post"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn khóa tài khoản này?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Khóa</button>
                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            <form asp-action="Unlock" asp-route-id="@user.Id" method="post"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn mở khóa tài khoản này?');">
                                                <button type="submit" class="btn btn-sm btn-outline-success">Mở khóa</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
