@model WarehouseManagement.Models.UserManagement.EditUserAccountViewModel
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="account-management py-3 py-lg-4">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">Quản lý tài khoản</div>
            <h1 class="h2 mb-1">Chỉnh sửa tài khoản</h1>
            <p class="text-secondary mb-0">Cập nhật thông tin và vai trò; mật khẩu không bị thay đổi.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Quay lại chi tiết</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="Edit" method="post" novalidate>
                <input asp-for="Id" type="hidden" />
                <input asp-for="ConcurrencyStamp" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-4">
                    <div class="col-12 col-lg-6">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="UserName" class="form-label fw-semibold"></label>
                        <input asp-for="UserName" class="form-control" autocomplete="username" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" class="form-select">
                            @foreach (var roleName in Model.AvailableRoles)
                            {
                                <option value="@roleName">@roleName</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="alert @(Model.IsActive ? "alert-success" : "alert-warning") mb-0">
                            Trạng thái hiện tại: <strong>@(Model.IsActive ? "Hoạt động" : "Đã khóa")</strong>.
                            Việc khóa hoặc mở khóa được thực hiện tại trang danh sách hoặc chi tiết tài khoản.
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
