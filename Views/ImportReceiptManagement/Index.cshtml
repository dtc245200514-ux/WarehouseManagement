@using WarehouseManagement.Models.Enums
@model WarehouseManagement.Models.ImportReceiptManagement.ImportReceiptIndexViewModel

@functions {
    private static string StatusText(ReceiptStatus status) => status switch
    {
        ReceiptStatus.Draft => "Nháp",
        ReceiptStatus.Posted => "Đã ghi sổ",
        ReceiptStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static string StatusBadge(ReceiptStatus status) => status switch
    {
        ReceiptStatus.Draft => "text-bg-secondary",
        ReceiptStatus.Posted => "text-bg-success",
        ReceiptStatus.Cancelled => "text-bg-danger",
        _ => "text-bg-light"
    };
}

@{
    ViewData["Title"] = "Danh sách phiếu nhập";
}

<div class="import-receipt-management">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Danh sách phiếu nhập kho</h1>
            <p class="text-muted mb-0">Theo dõi phiếu nháp và các phiếu đã ghi sổ.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Lập phiếu nhập</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-0" role="alert"></div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="SearchTerm" class="form-label">Số phiếu</label>
                    <input asp-for="SearchTerm" class="form-control" maxlength="100" placeholder="Nhập số phiếu" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="SupplierId" class="form-label">Nhà cung cấp</label>
                    <select asp-for="SupplierId" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var supplier in Model.Suppliers)
                        {
                            <option value="@supplier.Id">@supplier.Code - @supplier.Name</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label asp-for="Status" class="form-label">Trạng thái</label>
                    <select asp-for="Status" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="@ReceiptStatus.Draft">Nháp</option>
                        <option value="@ReceiptStatus.Posted">Đã ghi sổ</option>
                        <option value="@ReceiptStatus.Cancelled">Đã hủy</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label asp-for="FromDate" class="form-label">Từ ngày</label>
                    <input asp-for="FromDate" class="form-control" type="date" />
                </div>
                <div class="col-lg-2 col-md-4">
                    <label asp-for="ToDate" class="form-label">Đến ngày</label>
                    <input asp-for="ToDate" class="form-control" type="date" />
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary">Lọc dữ liệu</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Số phiếu</th>
                        <th>Ngày nhập</th>
                        <th>Nhà cung cấp</th>
                        <th>Người tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Thời gian tạo</th>
                        <th>Ghi sổ lúc</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Receipts.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">Không tìm thấy phiếu nhập phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var receipt in Model.Receipts)
                        {
                            <tr>
                                <td class="fw-semibold">@receipt.ReceiptNumber</td>
                                <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div>@receipt.SupplierName</div>
                                    <small class="text-muted">@receipt.SupplierCode</small>
                                </td>
                                <td>@receipt.CreatedByName</td>
                                <td><span class="badge @StatusBadge(receipt.Status)">@StatusText(receipt.Status)</span></td>
                                <td class="text-end fw-semibold">@receipt.TotalAmount.ToString("N2")</td>
                                <td>@receipt.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(receipt.PostedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="text-center text-nowrap">
                                    <a asp-action="Details" asp-route-id="@receipt.Id" class="btn btn-outline-secondary btn-sm">Chi tiết</a>
                                    @if (receipt.Status == ReceiptStatus.Draft)
                                    {
                                        <form asp-action="Post" asp-route-id="@receipt.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Ghi sổ phiếu này và cập nhật tồn kho?');">
                                            <input type="hidden" name="rowVersion" value="@receipt.RowVersion" />
                                            <button type="submit" class="btn btn-success btn-sm">Ghi sổ</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
