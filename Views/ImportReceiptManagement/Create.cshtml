@model WarehouseManagement.Models.ImportReceiptManagement.CreateImportReceiptViewModel

@{
    ViewData["Title"] = "Lập phiếu nhập kho";
}

<div class="import-receipt-management">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Lập phiếu nhập kho</h1>
            <p class="text-muted mb-0">Phiếu được lưu ở trạng thái Nháp và chưa làm thay đổi tồn kho.</p>
        </div>
        <span class="badge rounded-pill text-bg-secondary px-3 py-2">Trạng thái: Nháp</span>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="import-receipt-form" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Thông tin chung</h2>
                <div class="row g-3">
                    <div class="col-lg-7">
                        <label asp-for="SupplierId" class="form-label"></label>
                        <select asp-for="SupplierId" class="form-select" autofocus>
                            <option value="0">-- Chọn nhà cung cấp --</option>
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <option value="@supplier.Id">@supplier.Code - @supplier.Name</option>
                            }
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>
                    <div class="col-lg-5">
                        <label asp-for="ReceiptDate" class="form-label"></label>
                        <input asp-for="ReceiptDate" class="form-control" type="date" />
                        <span asp-validation-for="ReceiptDate" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Note" class="form-label"></label>
                        <textarea asp-for="Note" class="form-control" maxlength="500" rows="2"
                                  placeholder="Thông tin bổ sung cho phiếu nhập (nếu có)"></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex flex-wrap justify-content-between align-items-center gap-2 p-4 pb-2">
                <div>
                    <h2 class="h5 mb-1">Chi tiết hàng hóa</h2>
                    <p class="text-muted small mb-0">Mỗi hàng hóa chỉ được xuất hiện một lần trong phiếu.</p>
                </div>
                <button type="button" class="btn btn-outline-primary" id="add-detail-row">+ Thêm dòng</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" id="details-table">
                        <thead>
                            <tr>
                                <th class="text-center detail-index-column">STT</th>
                                <th class="product-column">Hàng hóa</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="details-body">
                            @for (var index = 0; index < Model.Details.Count; index++)
                            {
                                <tr class="detail-row">
                                    <td class="text-center detail-number">@(index + 1)</td>
                                    <td>
                                        <select asp-for="Details[index].ProductId" class="form-select product-select">
                                            <option value="0">-- Chọn hàng hóa --</option>
                                            @foreach (var product in Model.Products)
                                            {
                                                <option value="@product.Id">@product.Code - @product.Name (@product.Unit)</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Details[index].ProductId" class="text-danger detail-validation"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Details[index].Quantity" class="form-control quantity-input"
                                               type="number" step="0.001"
                                               data-msg-step="Số lượng chỉ được có tối đa 3 chữ số thập phân." />
                                        <span asp-validation-for="Details[index].Quantity" class="text-danger detail-validation"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Details[index].UnitCost" class="form-control unit-cost-input"
                                               type="number" step="0.01"
                                               data-msg-step="Đơn giá chỉ được có tối đa 2 chữ số thập phân." />
                                        <span asp-validation-for="Details[index].UnitCost" class="text-danger detail-validation"></span>
                                    </td>
                                    <td class="text-end fw-semibold line-total">0,00</td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-outline-primary btn-sm edit-detail-row">Sửa</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm remove-detail-row">Xóa</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="4" class="text-end">Tổng tiền</th>
                                <th class="text-end fs-5 text-primary" id="grand-total">0,00</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div id="client-detail-error" class="text-danger px-4 py-2 d-none" role="alert"></div>
            </div>
            <div class="card-footer bg-white border-0 p-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" id="save-receipt">Lưu phiếu nháp</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </div>
    </form>
</div>

<template id="detail-row-template">
    <tr class="detail-row">
        <td class="text-center detail-number"></td>
        <td>
            <select name="Details[__index__].ProductId" id="Details___index___ProductId" class="form-select product-select">
                <option value="0">-- Chọn hàng hóa --</option>
                @foreach (var product in Model.Products)
                {
                    <option value="@product.Id">@product.Code - @product.Name (@product.Unit)</option>
                }
            </select>
            <span class="text-danger detail-validation" data-valmsg-for="Details[__index__].ProductId" data-valmsg-replace="true"></span>
        </td>
        <td>
            <input name="Details[__index__].Quantity" id="Details___index___Quantity"
                   class="form-control quantity-input" type="number" step="0.001" value="0"
                   data-msg-step="Số lượng chỉ được có tối đa 3 chữ số thập phân."
                   data-val="true"
                   data-val-range="Số lượng phải lớn hơn 0 và không vượt quá giới hạn cho phép."
                   data-val-range-min="0.001" data-val-range-max="999999999999999.999" />
            <span class="text-danger detail-validation" data-valmsg-for="Details[__index__].Quantity" data-valmsg-replace="true"></span>
        </td>
        <td>
            <input name="Details[__index__].UnitCost" id="Details___index___UnitCost"
                   class="form-control unit-cost-input" type="number" step="0.01" value="0"
                   data-msg-step="Đơn giá chỉ được có tối đa 2 chữ số thập phân."
                   data-val="true"
                   data-val-range="Đơn giá phải từ 0 trở lên và không vượt quá giới hạn cho phép."
                   data-val-range-min="0" data-val-range-max="9999999999999999.99" />
            <span class="text-danger detail-validation" data-valmsg-for="Details[__index__].UnitCost" data-valmsg-replace="true"></span>
        </td>
        <td class="text-end fw-semibold line-total">0,00</td>
        <td class="text-center">
            <div class="d-inline-flex gap-1">
                <button type="button" class="btn btn-outline-primary btn-sm edit-detail-row">Sửa</button>
                <button type="button" class="btn btn-outline-danger btn-sm remove-detail-row">Xóa</button>
            </div>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/import-receipt-create.js" asp-append-version="true"></script>
}
