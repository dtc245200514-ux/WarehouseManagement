@model WarehouseManagement.Models.SupplierManagement.EditSupplierViewModel

@{
    ViewData["Title"] = "Chỉnh sửa nhà cung cấp";
}

<div class="supplier-management">
    <div class="mb-4">
        <h1 class="h3 mb-1">Chỉnh sửa nhà cung cấp</h1>
        <p class="text-muted mb-0">Mã @Model.Code được giữ cố định để bảo toàn lịch sử phiếu nhập.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="Edit" asp-route-id="@Model.SupplierId" method="post" novalidate>
                <input asp-for="SupplierId" type="hidden" />
                <input asp-for="RowVersion" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Mã nhà cung cấp</label>
                        <input value="@Model.Code" class="form-control" readonly />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" maxlength="200" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" maxlength="20" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" maxlength="150" type="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" maxlength="300" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="Details" asp-route-id="@Model.SupplierId" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
