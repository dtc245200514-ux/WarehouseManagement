@model WarehouseManagement.Models.SupplierManagement.SupplierIndexViewModel

@{
    ViewData["Title"] = "Quản lý nhà cung cấp";
}

<div class="supplier-management">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Quản lý nhà cung cấp</h1>
            <p class="text-muted mb-0">Tra cứu và quản lý đối tác cung cấp hàng hóa.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Thêm nhà cung cấp</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-7">
                    <label asp-for="SearchTerm" class="form-label">Từ khóa</label>
                    <input asp-for="SearchTerm" class="form-control" maxlength="200"
                           placeholder="Mã, tên, số điện thoại hoặc email..." />
                    <span asp-validation-for="SearchTerm" class="text-danger"></span>
                </div>
                <div class="col-md-5 col-lg-3">
                    <label asp-for="IsActive" class="form-label">Trạng thái</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="true">Đang hoạt động</option>
                        <option value="false">Ngừng hoạt động</option>
                    </select>
                </div>
                <div class="col-md-7 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary flex-grow-1">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        @if (Model.Suppliers.Count == 0)
        {
            <div class="card-body text-center py-5">
                <h2 class="h5">Không tìm thấy nhà cung cấp</h2>
                <p class="text-muted mb-0">Hãy thay đổi điều kiện tìm kiếm hoặc thêm nhà cung cấp mới.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã NCC</th>
                            <th>Tên nhà cung cấp</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in Model.Suppliers)
                        {
                            <tr>
                                <td class="fw-semibold">@supplier.Code</td>
                                <td>@supplier.Name</td>
                                <td>@(supplier.Phone ?? "—")</td>
                                <td>@(supplier.Email ?? "—")</td>
                                <td>
                                    @if (supplier.IsActive)
                                    {
                                        <span class="badge text-bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td>@supplier.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@supplier.Id"
                                       class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@supplier.Id"
                                       class="btn btn-sm btn-outline-primary">Sửa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
