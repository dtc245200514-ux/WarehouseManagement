@using System.Globalization
@model WarehouseManagement.Models.ExportReceiptManagement.CreateExportReceiptViewModel

@{
    ViewData["Title"] = "Lập phiếu xuất kho";
    var todayText = DateTime.Now.ToString("dd/MM/yyyy");
}

<div class="export-receipt-management">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Lập phiếu xuất kho</h1>
            <p class="text-muted mb-0">Phiếu được lưu ở trạng thái Nháp. Tồn kho chưa bị trừ và sẽ được kiểm tra lại khi ghi sổ.</p>
        </div>
        <span class="badge rounded-pill text-bg-secondary px-3 py-2">Trạng thái: Nháp</span>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (Model.Products.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            Hiện không có hàng hóa đang hoạt động và có tồn kho để lập phiếu xuất.
        </div>
    }

    <form asp-action="Create" method="post" id="export-receipt-form" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Thông tin chung</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="created-by-name">Người lập phiếu</label>
                        <input id="created-by-name" class="form-control" value="@Model.CreatedByName" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="created-date">Ngày lập phiếu</label>
                        <input id="created-date" class="form-control" value="@todayText" readonly />
                    </div>
                    <div class="col-12">
                        <label asp-for="Note" class="form-label"></label>
                        <textarea asp-for="Note" class="form-control" maxlength="500" rows="2"
                                  placeholder="Ví dụ: lý do xuất kho hoặc bộ phận nhận hàng"></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex flex-wrap justify-content-between align-items-center gap-2 p-4 pb-2">
                <div>
                    <h2 class="h5 mb-1">Chi tiết hàng hóa</h2>
                    <p class="text-muted small mb-0">Mỗi hàng hóa chỉ xuất hiện một lần; số lượng không được vượt tồn hiện tại.</p>
                </div>
                <button type="button" class="btn btn-outline-primary" id="add-export-detail-row">+ Thêm chi tiết</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" id="export-details-table">
                        <thead>
                            <tr>
                                <th class="text-center detail-index-column">STT</th>
                                <th class="product-column">Hàng hóa</th>
                                <th>Tồn hiện tại</th>
                                <th>Số lượng xuất</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="export-details-body">
                            @for (var index = 0; index < Model.Details.Count; index++)
                            {
                                <tr class="detail-row">
                                    <td class="text-center detail-number">@(index + 1)</td>
                                    <td>
                                        <select asp-for="Details[index].ProductId" class="form-select product-select">
                                            <option value="0">-- Chọn hàng hóa --</option>
                                            @foreach (var product in Model.Products)
                                            {
                                                <option value="@product.Id" data-stock="@product.CurrentQuantity.ToString(CultureInfo.InvariantCulture)">
                                                    @product.Code - @product.Name (@product.Unit) · Tồn: @product.CurrentQuantity.ToString("0.###", CultureInfo.InvariantCulture)
                                                </option>
                                            }
                                        </select>
                                        <span asp-validation-for="Details[index].ProductId" class="text-danger detail-validation"></span>
                                    </td>
                                    <td class="stock-cell text-nowrap">—</td>
                                    <td>
                                        <input asp-for="Details[index].Quantity" class="form-control quantity-input"
                                               type="number" step="0.001"
                                               data-msg-step="Số lượng chỉ được có tối đa 3 chữ số thập phân." />
                                        <span asp-validation-for="Details[index].Quantity" class="text-danger detail-validation"></span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-outline-primary btn-sm edit-detail-row">Sửa</button>
                                            <button type="button" class="btn btn-outline-danger btn-sm remove-detail-row">Xóa</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="export-client-error" class="text-danger px-4 py-2 d-none" role="alert"></div>
            </div>
            <div class="card-footer bg-white border-0 p-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" id="save-export-receipt"
                        disabled="@(Model.Products.Count == 0)">Lưu phiếu nháp</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </div>
    </form>
</div>

<template id="export-detail-row-template">
    <tr class="detail-row">
        <td class="text-center detail-number"></td>
        <td>
            <select name="Details[__index__].ProductId" id="Details___index___ProductId" class="form-select product-select">
                <option value="0">-- Chọn hàng hóa --</option>
                @foreach (var product in Model.Products)
                {
                    <option value="@product.Id" data-stock="@product.CurrentQuantity.ToString(CultureInfo.InvariantCulture)">
                        @product.Code - @product.Name (@product.Unit) · Tồn: @product.CurrentQuantity.ToString("0.###", CultureInfo.InvariantCulture)
                    </option>
                }
            </select>
            <span class="text-danger detail-validation" data-valmsg-for="Details[__index__].ProductId" data-valmsg-replace="true"></span>
        </td>
        <td class="stock-cell text-nowrap">—</td>
        <td>
            <input name="Details[__index__].Quantity" id="Details___index___Quantity"
                   class="form-control quantity-input" type="number" step="0.001" value="0"
                   data-msg-step="Số lượng chỉ được có tối đa 3 chữ số thập phân."
                   data-val="true"
                   data-val-range="Số lượng xuất phải lớn hơn 0 và không vượt quá giới hạn cho phép."
                   data-val-range-min="0.001" data-val-range-max="999999999999999.999" />
            <span class="text-danger detail-validation" data-valmsg-for="Details[__index__].Quantity" data-valmsg-replace="true"></span>
        </td>
        <td class="text-center">
            <div class="d-inline-flex gap-1">
                <button type="button" class="btn btn-outline-primary btn-sm edit-detail-row">Sửa</button>
                <button type="button" class="btn btn-outline-danger btn-sm remove-detail-row">Xóa</button>
            </div>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/export-receipt-create.js" asp-append-version="true"></script>
}
