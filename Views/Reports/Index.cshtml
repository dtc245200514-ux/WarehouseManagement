@model WarehouseManagement.Models.Reporting.WarehouseReportViewModel
@{
    ViewData["Title"] = "Báo cáo nhập–xuất–tồn";
    ViewData["FilterAction"] = "Index";
}
<div class="warehouse-reports">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><h1 class="h3 mb-1">Báo cáo nhập–xuất–tồn</h1><p class="text-muted mb-0">Từ 00:00 ngày bắt đầu đến trước 00:00 ngày sau ngày kết thúc, theo UTC. Để trống ngày = toàn bộ lịch sử / đến hiện tại.</p></div><a asp-action="Dashboard" class="btn btn-outline-secondary">Dashboard</a></div>
    <partial name="_Filters" model="Model.Filter" />
    <div class="alert alert-info small">Tồn đầu và cuối kỳ tính từ lịch sử giao dịch. Cột nhập/xuất chỉ tính giao dịch của phiếu <strong>Posted</strong>; biến động khác (tồn đầu kỳ, điều chỉnh hoặc đảo giao dịch) hiển thị riêng để đối chiếu. Không tính giá trị tiền tệ.</div>
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>STT</th><th>Mã hàng</th><th>Hàng hóa</th><th>Danh mục</th><th>Đơn vị</th><th class="text-end">Tồn đầu</th><th class="text-end">Nhập</th><th class="text-end">Xuất</th><th class="text-end">Biến động khác</th><th class="text-end">Tồn cuối</th><th class="text-end">Tồn hiện tại</th><th class="text-end">Tồn tối thiểu</th><th>Đối chiếu</th></tr></thead><tbody>
        @if (Model.Rows.Count == 0) { <tr><td colspan="13" class="text-center text-muted py-5">Không có hàng hóa phù hợp với bộ lọc.</td></tr> }
        else { @for (var i = 0; i < Model.Rows.Count; i++) { var row = Model.Rows[i]; <tr><td>@((Model.Page - 1) * 20 + i + 1)</td><td class="fw-semibold"><a asp-controller="Inventory" asp-action="Details" asp-route-id="@row.ProductId">@row.Code</a></td><td>@row.Name</td><td>@row.CategoryName</td><td>@row.Unit</td><td class="text-end">@row.OpeningQuantity.ToString("N3")</td><td class="text-end text-success">@row.ImportedQuantity.ToString("N3")</td><td class="text-end text-primary">@row.ExportedQuantity.ToString("N3")</td><td class="text-end">@row.OtherChange.ToString("+N3;-N3;N3")</td><td class="text-end fw-semibold">@row.ClosingQuantity.ToString("N3")</td><td class="text-end">@row.CurrentQuantity.ToString("N3")</td><td class="text-end">@row.MinimumStockLevel.ToString("N3")</td><td><a asp-controller="Inventory" asp-action="Transactions" asp-route-productId="@row.ProductId" class="btn btn-outline-primary btn-sm">Lịch sử</a></td></tr> } }
    </tbody></table></div>
    @if (Model.TotalPages > 1) { <nav class="card-body d-flex gap-2 align-items-center" aria-label="Phân trang báo cáo"><span>Trang @Model.Page / @Model.TotalPages</span>@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-fromDate="@Model.Filter.FromDate" asp-route-toDate="@Model.Filter.ToDate" asp-route-productId="@Model.Filter.ProductId" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-isActive="@Model.Filter.IsActive" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-sortBy="@Model.Filter.SortBy" class="btn btn-outline-secondary btn-sm">Trang trước</a> } @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-fromDate="@Model.Filter.FromDate" asp-route-toDate="@Model.Filter.ToDate" asp-route-productId="@Model.Filter.ProductId" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-isActive="@Model.Filter.IsActive" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-sortBy="@Model.Filter.SortBy" class="btn btn-outline-secondary btn-sm">Trang sau</a> }</nav> }
    </div>
    <p class="small text-muted mt-3">Tồn cuối kỳ = Tồn đầu kỳ + Nhập − Xuất + Biến động khác. Các số lượng của hàng hóa khác đơn vị tính không nên cộng thành một đơn vị vật lý chung.</p>
</div>
