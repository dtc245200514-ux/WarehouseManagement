@model WarehouseManagement.Models.CategoryManagement.CategoryIndexViewModel
@using WarehouseManagement.Authorization

@{
    ViewData["Title"] = "Quản lý danh mục";
    var canManage = User.IsInRole(ApplicationRoles.Admin);
}

<div class="category-management">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Quản lý danh mục</h1>
            <p class="text-muted mb-0">Tra cứu và quản lý nhóm hàng hóa trong kho.</p>
        </div>
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-primary">Thêm danh mục</a>
        }
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-7">
                    <label asp-for="SearchTerm" class="form-label">Tên hoặc mã danh mục</label>
                    <input asp-for="SearchTerm" class="form-control" maxlength="100"
                           placeholder="Nhập tên hoặc mã danh mục..." />
                    <span asp-validation-for="SearchTerm" class="text-danger"></span>
                </div>
                <div class="col-md-5 col-lg-3">
                    <label asp-for="IsActive" class="form-label">Trạng thái</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="true">Đang hoạt động</option>
                        <option value="false">Ngừng hoạt động</option>
                    </select>
                </div>
                <div class="col-md-7 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary flex-grow-1">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        @if (Model.Categories.Count == 0)
        {
            <div class="card-body text-center py-5">
                <h2 class="h5">Không tìm thấy danh mục</h2>
                <p class="text-muted mb-0">Hãy thay đổi điều kiện tìm kiếm hoặc thêm danh mục mới.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Tên danh mục</th>
                            <th>Mô tả</th>
                            <th>Số hàng hóa</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td class="fw-semibold">@category.Id</td>
                                <td>@category.Name</td>
                                <td class="text-muted">@(category.Description ?? "—")</td>
                                <td>@category.ProductCount</td>
                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="badge text-bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td>@category.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@category.Id"
                                       class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                    @if (canManage)
                                    {
                                        <a asp-action="Edit" asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-primary">Sửa</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
