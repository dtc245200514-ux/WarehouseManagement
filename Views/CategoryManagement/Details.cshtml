@model WarehouseManagement.Models.CategoryManagement.CategoryDetailsViewModel
@using WarehouseManagement.Authorization

@{
    ViewData["Title"] = "Chi tiết danh mục";
    var canManage = User.IsInRole(ApplicationRoles.Admin);
}

<div class="category-management">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Chi tiết danh mục</h1>
            <p class="text-muted mb-0">Mã danh mục: @Model.Id</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            @if (canManage)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Chỉnh sửa</a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <dl class="row mb-0 account-details">
                <dt class="col-md-4">Tên danh mục</dt>
                <dd class="col-md-8 fw-semibold">@Model.Name</dd>

                <dt class="col-md-4">Mô tả</dt>
                <dd class="col-md-8">@(Model.Description ?? "Chưa có mô tả")</dd>

                <dt class="col-md-4">Trạng thái</dt>
                <dd class="col-md-8">
                    @if (Model.IsActive)
                    {
                        <span class="badge text-bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Ngừng hoạt động</span>
                    }
                </dd>

                <dt class="col-md-4">Số hàng hóa đang tham chiếu</dt>
                <dd class="col-md-8">@Model.ProductCount</dd>

                <dt class="col-md-4">Thời gian tạo</dt>
                <dd class="col-md-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>

            @if (canManage)
            {
                <hr class="my-4" />
                @if (Model.ProductCount > 0)
                {
                    <div class="alert alert-warning">
                        Danh mục đang được @Model.ProductCount hàng hóa tham chiếu. Thay đổi trạng thái không xóa hoặc thay đổi các liên kết này.
                    </div>
                }
                <form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('@(Model.IsActive ? "Ngừng hoạt động danh mục này?" : "Kích hoạt lại danh mục này?")');">
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <button type="submit" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                        @(Model.IsActive ? "Ngừng hoạt động" : "Kích hoạt")
                    </button>
                </form>
            }
        </div>
    </div>
</div>
