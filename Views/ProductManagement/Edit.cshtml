@model WarehouseManagement.Models.ProductManagement.EditProductViewModel

@{
    ViewData["Title"] = "Chỉnh sửa hàng hóa";
}

<div class="product-management">
    <div class="mb-4">
        <h1 class="h3 mb-1">Chỉnh sửa hàng hóa</h1>
        <p class="text-muted mb-0">Mã hàng @Model.Code được giữ cố định để bảo toàn lịch sử giao dịch.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" novalidate>
                <input asp-for="ProductId" type="hidden" />
                <input asp-for="RowVersion" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Mã hàng</label>
                        <input value="@Model.Code" class="form-control" readonly />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" maxlength="200" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select">
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">
                                    @category.Name@(!category.IsActive ? " (ngừng hoạt động)" : string.Empty)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Unit" class="form-label"></label>
                        <input asp-for="Unit" class="form-control" maxlength="50" />
                        <span asp-validation-for="Unit" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MinimumStockLevel" class="form-label"></label>
                        <input asp-for="MinimumStockLevel" class="form-control" type="number" min="0" step="0.001" />
                        <span asp-validation-for="MinimumStockLevel" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" maxlength="500" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
