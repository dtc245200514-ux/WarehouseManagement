@model WarehouseManagement.Models.ProductManagement.ProductIndexViewModel

@{
    ViewData["Title"] = "Quản lý hàng hóa";
}

<div class="product-management">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Quản lý hàng hóa</h1>
            <p class="text-muted mb-0">Tra cứu và quản lý thông tin hàng hóa trong kho.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Thêm hàng hóa</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label asp-for="SearchTerm" class="form-label">Mã hoặc tên hàng hóa</label>
                    <input asp-for="SearchTerm" class="form-control" maxlength="200"
                           placeholder="Nhập mã hoặc tên hàng hóa..." />
                    <span asp-validation-for="SearchTerm" class="text-danger"></span>
                </div>
                <div class="col-md-4 col-lg-3">
                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Tất cả danh mục</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">
                                @category.Name@(!category.IsActive ? " (ngừng hoạt động)" : string.Empty)
                            </option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-4 col-lg-2">
                    <label asp-for="Unit" class="form-label">Đơn vị tính</label>
                    <select asp-for="Unit" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var unit in Model.Units)
                        {
                            <option value="@unit">@unit</option>
                        }
                    </select>
                    <span asp-validation-for="Unit" class="text-danger"></span>
                </div>
                <div class="col-md-4 col-lg-2">
                    <label asp-for="IsActive" class="form-label">Trạng thái</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="true">Đang hoạt động</option>
                        <option value="false">Ngừng hoạt động</option>
                    </select>
                </div>
                <div class="col-md-8 col-lg-1 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary">Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        @if (Model.Products.Count == 0)
        {
            <div class="card-body text-center py-5">
                <h2 class="h5">Không tìm thấy hàng hóa</h2>
                <p class="text-muted mb-0">Hãy thay đổi điều kiện lọc hoặc thêm hàng hóa mới.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã hàng</th>
                            <th>Tên hàng hóa</th>
                            <th>Danh mục</th>
                            <th>Đơn vị</th>
                            <th class="text-end">Tồn hiện tại</th>
                            <th class="text-end">Tồn tối thiểu</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td class="fw-semibold">@product.Code</td>
                                <td>@product.Name</td>
                                <td>@product.CategoryName</td>
                                <td>@product.Unit</td>
                                <td class="text-end">@product.CurrentQuantity.ToString("0.###")</td>
                                <td class="text-end">@product.MinimumStockLevel.ToString("0.###")</td>
                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="badge text-bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@product.Id"
                                       class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@product.Id"
                                       class="btn btn-sm btn-outline-primary">Sửa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
