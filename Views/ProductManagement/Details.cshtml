@model WarehouseManagement.Models.ProductManagement.ProductDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết hàng hóa";
}

<div class="product-management">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Chi tiết hàng hóa</h1>
            <p class="text-muted mb-0">@Model.Code - @Model.Name</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Chỉnh sửa</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <dl class="row mb-0 account-details">
                <dt class="col-md-4">Mã hàng</dt>
                <dd class="col-md-8 fw-semibold">@Model.Code</dd>
                <dt class="col-md-4">Tên hàng hóa</dt>
                <dd class="col-md-8">@Model.Name</dd>
                <dt class="col-md-4">Danh mục</dt>
                <dd class="col-md-8">
                    @Model.CategoryName
                    @if (!Model.CategoryIsActive)
                    {
                        <span class="badge text-bg-warning ms-1">Danh mục đã ngừng hoạt động</span>
                    }
                </dd>
                <dt class="col-md-4">Đơn vị tính</dt>
                <dd class="col-md-8">@Model.Unit</dd>
                <dt class="col-md-4">Tồn hiện tại</dt>
                <dd class="col-md-8">@Model.CurrentQuantity.ToString("0.###")</dd>
                <dt class="col-md-4">Mức tồn tối thiểu</dt>
                <dd class="col-md-8">@Model.MinimumStockLevel.ToString("0.###")</dd>
                <dt class="col-md-4">Mô tả</dt>
                <dd class="col-md-8">@(Model.Description ?? "Chưa có mô tả")</dd>
                <dt class="col-md-4">Trạng thái</dt>
                <dd class="col-md-8">
                    <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">
                        @(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                    </span>
                </dd>
                <dt class="col-md-4">Thời gian tạo</dt>
                <dd class="col-md-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                <dt class="col-md-4">Cập nhật gần nhất</dt>
                <dd class="col-md-8">@(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</dd>
            </dl>

            <hr class="my-4" />
            <form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('@(Model.IsActive ? "Ngừng hoạt động hàng hóa này?" : "Kích hoạt lại hàng hóa này?")');">
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                    @(Model.IsActive ? "Ngừng hoạt động" : "Kích hoạt")
                </button>
            </form>
        </div>
    </div>
</div>
