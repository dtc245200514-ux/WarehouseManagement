@model ErrorViewModel
@{ ViewData["Title"] = "Có lỗi xảy ra"; }
<section class="card"><div class="card-body"><h1 class="h3 text-danger">Không thể xử lý yêu cầu</h1><p>Vui lòng thử lại sau hoặc liên hệ người quản trị.</p>
@if (Model.ShowRequestId) { <p class="mb-0"><strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code></p> }
</div></section>
